RewriteEngine On
RewriteRule ^search/?$ FrontEnd/pages/hasil_pencarian.php [QSA,L]
RewriteRule ^api/destinations/search/?$ Backend/api/destinations_search.php [QSA,L]
RewriteRule ^api/destinations/([^/]+)/reviews/?$ Backend/api/destination_reviews.php?id=$1 [B,QSA,L]
RewriteRule ^api/destinations/([^/]+)/location/?$ Backend/api/destination_location.php?id=$1 [B,QSA,L]
RewriteRule ^users/me/?$ Backend/api/users_me.php [QSA,L]
RewriteRule ^categories/?$ Backend/api/categories.php [QSA,L]
RewriteRule ^categories/([^/]+)/wisata/?$ Backend/api/wisata_by_category.php?id_kategori=$1 [B,L]
