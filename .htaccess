RewriteEngine On
RewriteRule ^search/?$ FrontEnd/pages/hasil_pencarian.php [QSA,L]
RewriteRule ^api/destinations/search/?$ Backend/api/destinations_search.php [QSA,L]
RewriteRule ^api/favorites/?$ Backend/api/favorites.php [QSA,L]
RewriteRule ^api/destinations/([^/]+)/reviews/?$ Backend/api/destination_reviews.php?id=$1 [B,QSA,L]
RewriteRule ^api/destinations/([^/]+)/location/?$ Backend/api/destination_location.php?id=$1 [B,QSA,L]
RewriteRule ^users/me/?$ Backend/api/users_me.php [QSA,L]
RewriteRule ^api/user/change-password/?$ Backend/api/change_password.php [QSA,L]
RewriteRule ^api/admin/login/?$ Backend/api/admin_login.php [QSA,L]
RewriteRule ^api/admin/logout/?$ Backend/api/admin_logout.php [QSA,L]
RewriteRule ^api/admin/dashboard/?$ Backend/api/admin_dashboard.php [QSA,L]
RewriteRule ^api/admin/dashboard/summary/?$ Backend/api/admin_dashboard_summary.php [QSA,L]
RewriteRule ^api/admin/users/?$ Backend/api/admin_users.php [QSA,L]
RewriteRule ^api/admin/reviews/?$ Backend/api/admin_reviews.php [QSA,L]
RewriteRule ^api/admin/reviews/([0-9]+)/?$ Backend/api/admin_reviews.php?id=$1 [B,QSA,L]
RewriteRule ^categories/?$ Backend/api/categories.php [QSA,L]
RewriteRule ^categories/([^/]+)/wisata/?$ Backend/api/wisata_by_category.php?id_kategori=$1 [B,L]
RewriteRule ^api/admin/facilities/?$ Backend/api/admin_facilities.php [QSA,L]
RewriteRule ^api/admin/facilities/([^/]+)/?$ Backend/api/admin_facilities.php?id=$1 [B,QSA,L]
RewriteRule ^api/admin/categories/?$ Backend/api/admin_categories.php [QSA,L]
RewriteRule ^api/admin/categories/([^/]+)/?$ Backend/api/admin_categories.php?id=$1 [B,QSA,L]
RewriteRule ^api/admin/regions/?$ Backend/api/admin_regions_lookup.php [QSA,L]
RewriteRule ^api/admin/destinations/?$ Backend/api/admin_destinations.php [QSA,L]
RewriteRule ^api/admin/destinations/([^/]+)/?$ Backend/api/admin_destinations.php?id=$1 [B,QSA,L]
